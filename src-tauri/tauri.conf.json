{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorekeeper",
  "version": "0.1.0",
  "identifier": "com.lorekeeper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lorekeeper",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["lorekeeper"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
